{% extends 'layouts/base.twig' %}

{% block title %}
  about | SHIBAHARA
{% endblock %}

{% block content %}
  <div class="about-content">
    <div class="about-title">
      <h2>ABOUT</h2>
      <p>自己紹介</p>
    </div>
    <section class="about-profile">
      <div class="about-profile-text">
        <span class="about-section-index">01</span>
        <h1>Shibahara Reimi</h1>
        <p class="about-role">Web Engineer / Full Stack Developer</p>
        <p class="about-lead">
          PHPを中心にWebサイト・Webシステムの構築、改修、運用改善を行っています<br>
          要件整理から設計・実装、公開後の保守まで見据えた開発を大切にしています
        </p>
      </div>
      <dl class="about-profile-list">
        <div>
          <dt>名前</dt>
          <dd>Shibahara Reimi</dd>
        </div>
        <div>
          <dt>職種</dt>
          <dd>Web Engineer / Full Stack Developer</dd>
        </div>
        <div>
          <dt>活動拠点</dt>
          <dd>名古屋</dd>
        </div>
        <div>
          <dt>対応領域</dt>
          <dd>開発 / 改修 / 運用改善</dd>
        </div>
        <div>
          <dt>主な技術</dt>
          <dd>PHP / Linux / MySQL / JavaScript</dd>
        </div>
      </dl>
    </section>

    <div class="about-grid">
      <section class="about-panel">
        <span class="about-section-index">02</span>
        <h3 id="about-strengths-title">得意なこと</h3>
        <ul>
          <li>PHPを用いたWebサイト・Webシステム構築</li>
          <li>既存サイトの改修・機能追加</li>
          <li>サーバー移行・切り替え対応</li>
          <li>管理画面・お問い合わせフォーム実装</li>
        </ul>
      </section>

      <section class="about-panel">
        <span class="about-section-index">03</span>
        <h3 id="about-skills-title">スキル</h3>
        <div class="about-skill-tags">
          {% for skill in publishedSkills %}
            <span>{{ skill.name }}</span>
          {% endfor %}
        </div>
      </section>

      <section class="about-panel">
        <span class="about-section-index">04</span>
        <h3 id="about-experience-title">経験内容</h3>
        <ul>
          <li>コーポレートサイトの新規構築</li>
          <li>業務向けWebシステムの開発</li>
          <li>フォーム、一覧検索、管理画面などの実装</li>
          <li>サーバー移行に伴う動作検証・設定変更</li>
          <li>公開後の運用・保守サポート</li>
        </ul>
      </section>

      <section class="about-panel about-values">
        <span class="about-section-index">05</span>
        <h3 id="about-values-title">大切にしていること</h3>
        <p>
          ただ動くものを作るだけでなく、使う人にとって分かりやすく<br>
          運用する人にとって扱いやすいシステムであることを大切にしています
        </p>
        <p>
          公開後の変更や保守まで見据え、長く使い続けられるWebを目指して実装します
        </p>
      </section>
    </div>
  </div>
{% endblock %}
