<section class="dashboard-summary">
  {% if firstCard is defined %}
    <article class="summary-card {{ firstCard.class }}">
      <div class="summary-card-icon">
        <img src="{{ firstCard.icon }}">
      </div>
      <div>
        <p class="summary-card-label">{{ firstCard.label }}</p>
        <p class="summary-card-count">
          {{ firstCard.count }}<span>件</span>
        </p>
      </div>
      {# トップページ用 #}
      {% if firstCard.breakdown is defined %}
        <p class="summary-card-breakdown">
          {{ firstCard.breakdown.publishLabel }}
          <strong>{{ firstCard.breakdown.publishCount }}</strong>
          <span>/</span>
          {{ firstCard.breakdown.unpublishLabel }}
          <em>{{ firstCard.breakdown.unpublishCount }}</em>
        </p>
      {% endif %}
    </article>
  {% endif %}

  {% if secondCard is defined %}
    <article class="summary-card {{ secondCard.class }}">
      <div class="summary-card-icon">
        <img src="{{ secondCard.icon }}">
      </div>
