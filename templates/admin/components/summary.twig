          {{ thirdCard.breakdown.publishLabel }}
          <strong>{{ thirdCard.breakdown.publishCount }}</strong>
          <span>/</span>
          {{ thirdCard.breakdown.unpublishLabel }}
          <em>{{ thirdCard.breakdown.unpublishCount }}</em>
        </p>
      {% endif %}
    </article>
  {% endif %}

  {% if fourthCard is defined %}
    <article class="summary-card {{ fourthCard.class }}">
      <div class="summary-card-icon">
        <img src="{{ fourthCard.icon }}">
      </div>
      <div>
        <p class="summary-card-label">{{ fourthCard.label }}</p>
        <p class="summary-card-count">
          {{ fourthCard.count }}<span>件</span>
        </p>
      </div>
    </article>
  {% endif %}
</section>
