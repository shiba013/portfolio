          {{ secondCard.breakdown.publishLabel }}
          <strong>{{ secondCard.breakdown.publishCount }}</strong>
          <span>/</span>
          {{ secondCard.breakdown.unpublishLabel }}
          <em>{{ secondCard.breakdown.unpublishCount }}</em>
        </p>
      {% endif %}
    </article>
  {% endif %}

  {% if thirdCard is defined %}
    <article class="summary-card {{ thirdCard.class }}">
      <div class="summary-card-icon">
        <img src="{{ thirdCard.icon }}">
      </div>
      <div>
        <p class="summary-card-label">{{ thirdCard.label }}</p>
        <p class="summary-card-count">
          {{ thirdCard.count }}<span>件</span>
        </p>
      </div>
      {# トップページ用 #}
      {% if thirdCard.breakdown is defined %}
